# 本机快速演示（SQLite 仅供开发联调；MySQL 部署配置见 README）
APP_DATABASE_URL=sqlite:///artifacts/app.db
BUSINESS_DATABASE_URL=sqlite:///artifacts/business.db
MODEL_MODE=demo
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
MODEL_API_KEY=
# 登录后可在“数据库与模型设置”保存当前用户的模型配置，覆盖上述服务器默认项。
# MySQL 部署模板见 .env.mysql.example；共享数据库连接可由管理员在页面添加。
# CONFIG_KEY_PATH=artifacts/config.key
MODEL_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=8
QUERY_TIMEOUT_MS=1500
DEMO_PASSWORD=erp-demo-2026
DATA_START=2024-11-01
DATA_END=2026-11-01
DATA_VERSION=demo-v1-seed42
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Windows 默认自动使用已安装的 Edge / Chrome；也可显式选择，免下载浏览器。
# BROWSER_CHANNEL=msedge
# BROWSER_CHANNEL=chrome
# 非标准安装路径优先于 BROWSER_CHANNEL，Windows 路径推荐正斜杠。
# BROWSER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
