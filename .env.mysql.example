# 推荐部署配置：应用数据与业务数据都使用 MySQL。
# 复制为 .env 前先备份已有配置；替换地址和密码，初始化步骤见 README。
APP_DATABASE_URL=mysql+pymysql://app_writer:local-writer-change-me@127.0.0.1:3306/nlq_app?charset=utf8mb4
BUSINESS_DATABASE_URL=mysql+pymysql://query_reader:local-reader-change-me@127.0.0.1:3306/erp_demo?charset=utf8mb4
MODEL_MODE=demo
# 登录后通过“数据库与模型设置”为当前账号配置真实模型 API。
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
MODEL_API_KEY=
DEMO_PASSWORD=erp-demo-2026
DATA_START=2024-11-01
DATA_END=2026-11-01
DATA_VERSION=demo-v1-seed42
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# 配置密钥默认位于 artifacts/config.key，请和应用数据库一起备份。
# CONFIG_KEY_PATH=artifacts/config.key
